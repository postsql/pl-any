{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.github.com/events/GollumEvent.schema.json",
  "title": "GollumEvent",
  "description": "Draft-07 JSON Schema for GitHub Archive GollumEvent",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "GollumEvent"
      ],
      "description": "Unique discriminator for GollumEvent"
    },
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "login": {
          "type": "string"
        },
        "display_login": {
          "type": "string"
        },
        "gravatar_id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "avatar_url": {
          "type": "string"
        }
      }
    },
    "repo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "payload": {
      "type": "object",
      "properties": {
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "page_name": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "summary": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "action": {
                "type": "string"
              },
              "sha": {
                "type": "string"
              },
              "html_url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "public": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "org": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "login": {
          "type": "string"
        },
        "gravatar_id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "avatar_url": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "id",
    "type",
    "created_at"
  ]
}