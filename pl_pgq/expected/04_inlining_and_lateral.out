--
-- 04_inlining_and_lateral.sql
-- Verifies planner inlining via plpgq_graph_table_support (prosupport),
-- outer WHERE predicate pushdown, LATERAL outer-table Var correlation,
-- and JSONB/parameterized overloads.
--
CREATE SCHEMA pgq_inline_test;
SET search_path = pgq_inline_test, public;
CREATE TABLE accounts (
  acc_id int PRIMARY KEY,
  owner text,
  tier text
);
CREATE TABLE transfers (
  tx_id int PRIMARY KEY,
  from_acc int REFERENCES accounts(acc_id),
  to_acc int REFERENCES accounts(acc_id),
  amount numeric
);
INSERT INTO accounts VALUES
  (1, 'Alice', 'gold'),
  (2, 'Bob', 'silver'),
  (3, 'Carol', 'gold'),
  (4, 'Dave', 'bronze');
INSERT INTO transfers VALUES
  (1001, 1, 2, 250.00),
  (1002, 2, 3, 125.00),
  (1003, 1, 3, 500.00),
  (1004, 3, 4, 75.00);
CREATE FUNCTION fin_graph() RETURNS "PROPERTY GRAPH"
LANGUAGE "CREATE PROPERTY GRAPH" AS $$
  VERTEX TABLES (
    accounts LABEL account PROPERTIES ALL COLUMNS
  )
  EDGE TABLES (
    transfers
      SOURCE KEY (from_acc) REFERENCES accounts
      DESTINATION KEY (to_acc) REFERENCES accounts
      LABEL transfer PROPERTIES ALL COLUMNS
  )
$$;
-- 1. EXPLAIN (COSTS OFF) verifying GRAPH_TABLE is inlined into native joins
--    (no Function Scan on graph_table) and outer WHERE pushes down to accounts_pkey
EXPLAIN (COSTS OFF)
SELECT receiver, amount
  FROM GRAPH_TABLE(
    fin_graph(),
    'MATCH (s IS account)-[t IS transfer]->(r IS account) COLUMNS (s.acc_id AS sender_id, r.owner AS receiver, t.amount)'
  )
 WHERE sender_id = 1
 ORDER BY receiver;
                            QUERY PLAN                            
------------------------------------------------------------------
 Sort
   Sort Key: __f2.owner
   ->  Nested Loop
         ->  Index Only Scan using accounts_pkey on accounts __f0
               Index Cond: (acc_id = 1)
         ->  Hash Join
               Hash Cond: (__f2.acc_id = __f1.to_acc)
               ->  Seq Scan on accounts __f2
               ->  Hash
                     ->  Seq Scan on transfers __f1
                           Filter: (from_acc = 1)
(11 rows)

SELECT receiver, amount
  FROM GRAPH_TABLE(
    fin_graph(),
    'MATCH (s IS account)-[t IS transfer]->(r IS account) COLUMNS (s.acc_id AS sender_id, r.owner AS receiver, t.amount)'
  )
 WHERE sender_id = 1
 ORDER BY receiver;
 receiver | amount 
----------+--------
 Bob      | 250.00
 Carol    | 500.00
(2 rows)

-- 2. LATERAL correlation with outer table in FROM clause (without AS (...))
CREATE TABLE watch_list (target_owner text, min_amt numeric);
INSERT INTO watch_list VALUES ('Alice', 300.00), ('Bob', 100.00);
EXPLAIN (COSTS OFF)
SELECT w.target_owner, gt.receiver, gt.amount
  FROM watch_list w,
       GRAPH_TABLE(
         fin_graph(),
         'MATCH (s IS account)-[t IS transfer]->(r IS account) WHERE s.owner = w.target_owner AND t.amount >= w.min_amt COLUMNS (r.owner AS receiver, t.amount)'
       ) gt
 ORDER BY w.target_owner, gt.receiver;
                             QUERY PLAN                             
--------------------------------------------------------------------
 Incremental Sort
   Sort Key: w.target_owner, __f2.owner
   Presorted Key: w.target_owner
   ->  Merge Join
         Merge Cond: (w.target_owner = __f0.owner)
         Join Filter: (__f1.amount >= w.min_amt)
         ->  Sort
               Sort Key: w.target_owner
               ->  Seq Scan on watch_list w
         ->  Sort
               Sort Key: __f0.owner
               ->  Hash Join
                     Hash Cond: (__f1.to_acc = __f2.acc_id)
                     ->  Hash Join
                           Hash Cond: (__f1.from_acc = __f0.acc_id)
                           ->  Seq Scan on transfers __f1
                           ->  Hash
                                 ->  Seq Scan on accounts __f0
                     ->  Hash
                           ->  Seq Scan on accounts __f2
(20 rows)

SELECT w.target_owner, gt.receiver, gt.amount
  FROM watch_list w,
       GRAPH_TABLE(
         fin_graph(),
         'MATCH (s IS account)-[t IS transfer]->(r IS account) WHERE s.owner = w.target_owner AND t.amount >= w.min_amt COLUMNS (r.owner AS receiver, t.amount)'
       ) gt
 ORDER BY w.target_owner, gt.receiver;
 target_owner | receiver | amount 
--------------+----------+--------
 Alice        | Carol    | 500.00
 Bob          | Carol    | 125.00
(2 rows)

-- 3. Parameterized GRAPH_TABLE(pg, pattern, jsonb_params) and graph_table_jsonb
SELECT receiver, amount
  FROM GRAPH_TABLE(
    fin_graph(),
    'MATCH (s IS account)-[t IS transfer]->(r IS account) WHERE s.owner = :owner_name COLUMNS (r.owner AS receiver, t.amount)',
    '{"owner_name": "Alice"}'::jsonb
  ) AS gt(receiver text, amount numeric)
 ORDER BY amount;
 receiver | amount 
----------+--------
 Bob      | 250.00
 Carol    | 500.00
(2 rows)

SELECT row_data
  FROM graph_table_jsonb(
    fin_graph(),
    'MATCH (s IS account)-[t IS transfer]->(r IS account) WHERE s.owner = $1 COLUMNS (r.owner AS receiver, t.amount)',
    '["Bob"]'::jsonb
  ) AS row_data;
               row_data               
--------------------------------------
 {"amount": 125, "receiver": "Carol"}
(1 row)

DROP SCHEMA pgq_inline_test CASCADE;
NOTICE:  drop cascades to 4 other objects
DETAIL:  drop cascades to table accounts
drop cascades to table transfers
drop cascades to function fin_graph()
drop cascades to table watch_list
