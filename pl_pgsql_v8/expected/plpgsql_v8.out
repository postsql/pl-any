(1 row)

-- ============================================================================
-- 7. Cursors: Bound Cursors (with args), Unbound REFCURSOR, FETCH, MOVE, CLOSE,
--    and FOR rec IN bound_cursor(arg) LOOP
-- ============================================================================
CREATE FUNCTION test_cursors_v8() RETURNS jsonb AS $$
DECLARE
  c_bound CURSOR (max_id int) FOR SELECT id, name FROM plpgsql_v8_items WHERE id <= max_id ORDER BY id;
  c_ref refcursor;
  v_id int;
  v_name text;
  r RECORD;
  fetched_names text[] := ARRAY[]::text[];
  loop_names text[] := ARRAY[]::text[];
BEGIN
  OPEN c_bound(3);
  FETCH NEXT FROM c_bound INTO v_id, v_name;
  fetched_names := fetched_names || (v_id || ':' || v_name);
  MOVE NEXT FROM c_bound;
  FETCH NEXT FROM c_bound INTO v_id, v_name;
  fetched_names := fetched_names || (v_id || ':' || v_name);
  CLOSE c_bound;

  -- Cursor FOR loop automatically opens, fetches, and closes c_bound
  FOR r IN c_bound(2) LOOP
    loop_names := loop_names || r.name;
  END LOOP;

  -- Unbound refcursor with OPEN ... FOR EXECUTE ... USING
  OPEN c_ref FOR EXECUTE 'SELECT id, name FROM plpgsql_v8_items WHERE id = $1' USING 20;
  FETCH c_ref INTO v_id, v_name;
  CLOSE c_ref;

  RETURN jsonb_build_object(
    'fetched_names', fetched_names,
    'loop_names', loop_names,
    'ref_item', v_id || ':' || v_name
  );
END;
$$ LANGUAGE plpgsql_v8;
SELECT jsonb_pretty(test_cursors_v8());
          jsonb_pretty           
---------------------------------
 {                              +
     "ref_item": "20:from_proc",+
     "loop_names": [            +
         "alpha",               +
         "beta"                 +
     ],                         +
     "fetched_names": [         +
         "1:alpha",             +
         "3:gamma"              +
     ]                          +
 }
(1 row)

-- ============================================================================
-- 8. Triggers (NEW, OLD, TG_OP, TG_NAME, TG_TABLE_NAME, 0-based TG_ARGV) and DO blocks
-- ============================================================================
CREATE TABLE plpgsql_v8_audit (
  op text,
  tbl text,
  arg0 text,
  detail text
);
CREATE FUNCTION plpgsql_v8_trig_fn() RETURNS trigger AS $$
BEGIN
  IF TG_OP = 'INSERT' THEN
    NEW.name := TG_ARGV[0] || '_' || NEW.name;
    INSERT INTO plpgsql_v8_audit VALUES (TG_OP, TG_TABLE_NAME, TG_ARGV[0], NEW.name || ':' || NEW.qty);
    RETURN NEW;
  ELSIF TG_OP = 'UPDATE' THEN
    IF NEW.qty < 0 THEN
      RETURN NULL; -- skip update if negative qty
    END IF;
    INSERT INTO plpgsql_v8_audit VALUES (TG_OP, TG_TABLE_NAME, TG_ARGV[0], OLD.qty || '->' || NEW.qty);
    RETURN NEW;
  ELSIF TG_OP = 'DELETE' THEN
    INSERT INTO plpgsql_v8_audit VALUES (TG_OP, TG_TABLE_NAME, TG_ARGV[0], OLD.name);
    RETURN OLD;
  END IF;
  RETURN NULL;
END;
$$ LANGUAGE plpgsql_v8;
CREATE TRIGGER tr_plpgsql_v8
  BEFORE INSERT OR UPDATE OR DELETE ON plpgsql_v8_items
  FOR EACH ROW EXECUTE FUNCTION plpgsql_v8_trig_fn('pfx');
INSERT INTO plpgsql_v8_items VALUES (30, 'trigitem', 77);
UPDATE plpgsql_v8_items SET qty = -5 WHERE id = 30; -- skipped by trigger returning NULL
UPDATE plpgsql_v8_items SET qty = 88 WHERE id = 30;
DELETE FROM plpgsql_v8_items WHERE id = 30;
SELECT * FROM plpgsql_v8_audit ORDER BY op;
   op   |       tbl        | arg0 |     detail      
--------+------------------+------+-----------------
 DELETE | plpgsql_v8_items | pfx  | pfx_trigitem
 INSERT | plpgsql_v8_items | pfx  | pfx_trigitem:77
 UPDATE | plpgsql_v8_items | pfx  | 77->88
(3 rows)

-- Inline DO block in LANGUAGE plpgsql_v8
DO $$
DECLARE
  cnt int;
BEGIN
  SELECT count(*) INTO cnt FROM plpgsql_v8_audit;
  RAISE NOTICE 'audit count from DO block = %', cnt;
END;
$$ LANGUAGE plpgsql_v8;
NOTICE:  audit count from DO block = 3
