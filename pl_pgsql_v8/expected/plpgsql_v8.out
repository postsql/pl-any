SELECT plv8.compile_plpgsql('BEGIN RETURN 1 + 2; END;') LIKE '%__rt.add(1, 2)%' AS has_fast_path_add;
 has_fast_path_add 
-------------------
 t
(1 row)

SELECT plv8.compile_plpgsql('BEGIN RETURN QUERY SELECT 1; END;') LIKE '%__rt.returnQuery(%' AS has_direct_return_query;
 has_direct_return_query 
-------------------------
