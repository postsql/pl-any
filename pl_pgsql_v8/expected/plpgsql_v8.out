(1 row)

-- ============================================================================
-- 9. Negative Tests & Unprivileged Role Security Verification
-- ============================================================================
\set VERBOSITY terse
-- Constant variable assignment rejected at compile time
CREATE FUNCTION bad_const_assign() RETURNS int AS $$
DECLARE
  c CONSTANT int := 1;
BEGIN
  c := 2;
  RETURN c;
END;
$$ LANGUAGE plpgsql_v8;
ERROR:  PL/pgSQL syntax error: variable "c" is declared CONSTANT at or near "c" (line 5)
-- NOT NULL without default rejected at compile time
CREATE FUNCTION bad_notnull_decl() RETURNS int AS $$
DECLARE
  x int NOT NULL;
BEGIN
  RETURN x;
END;
$$ LANGUAGE plpgsql_v8;
ERROR:  variable "x" declared NOT NULL must have a default
-- Assigning NULL to NOT NULL variable raises 22004 at runtime
CREATE FUNCTION runtime_notnull_violation(v int) RETURNS int AS $$
DECLARE
  x int NOT NULL := 1;
BEGIN
  x := v;
  RETURN x;
END;
$$ LANGUAGE plpgsql_v8;
SELECT runtime_notnull_violation(NULL);
ERROR:  null value cannot be assigned to variable "x" declared NOT NULL
-- Invalid FOR loop step <= 0 raises 22023 at runtime
DO $$
BEGIN
  FOR i IN 1 .. 5 BY 0 LOOP
    NULL;
  END LOOP;
END;
$$ LANGUAGE plpgsql_v8;
ERROR:  step size must be greater than zero
\set VERBOSITY default
-- Unprivileged role can use LANGUAGE plpgsql_v8 when granted USAGE ON LANGUAGE,
-- while direct EXECUTE on plv8_plpgsql_handler() and plv8.compile_plpgsql() is revoked from PUBLIC
CREATE ROLE regress_plpgsql_v8_user;
GRANT USAGE ON SCHEMA public TO regress_plpgsql_v8_user;
GRANT CREATE ON SCHEMA public TO regress_plpgsql_v8_user;
GRANT USAGE ON LANGUAGE plpgsql_v8 TO regress_plpgsql_v8_user;
SET ROLE regress_plpgsql_v8_user;
\set VERBOSITY terse
SELECT plv8.compile_plpgsql('BEGIN RETURN; END;');
ERROR:  permission denied for function compile_plpgsql
\set VERBOSITY default
CREATE FUNCTION unpriv_plpgsql_v8_add(a int, b int) RETURNS int AS $$
DECLARE
  s int;
BEGIN
  s := a + b;
  RETURN s;
END;
$$ LANGUAGE plpgsql_v8;
SELECT unpriv_plpgsql_v8_add(19, 23);
 unpriv_plpgsql_v8_add 
-----------------------
                    42
(1 row)

DROP FUNCTION unpriv_plpgsql_v8_add(int, int);
RESET ROLE;
REVOKE ALL ON SCHEMA public FROM regress_plpgsql_v8_user;
REVOKE USAGE ON LANGUAGE plpgsql_v8 FROM regress_plpgsql_v8_user;
DROP ROLE regress_plpgsql_v8_user;
-- ============================================================================
-- 10. Edge Cases: RAISE EXCEPTION without handler, CASE in EXCEPTION block,
--     nested subtransaction EXIT/CONTINUE, 64-bit bigint, and DML column lists
-- ============================================================================
-- 10a. RAISE EXCEPTION in a block without an EXCEPTION handler
CREATE FUNCTION test_raise_no_handler(x int) RETURNS int AS $$
BEGIN
  IF x < 0 THEN
    RAISE EXCEPTION 'negative input: %', x USING ERRCODE = '22023';
  END IF;
  RETURN x * 2;
END;
$$ LANGUAGE plpgsql_v8;
SELECT test_raise_no_handler(21);
 test_raise_no_handler 
-----------------------
                    42
(1 row)

\set VERBOSITY terse
SELECT test_raise_no_handler(-5);
ERROR:  negative input: -5
\set VERBOSITY default
DROP FUNCTION test_raise_no_handler(int);
-- 10b. Searched CASE expression compiled to pure JS (no evalSql) and inside BEGIN..EXCEPTION..END
SELECT plv8.compile_plpgsql('BEGIN RETURN CASE WHEN 1 < 2 THEN 10 ELSE 20 END; END;') NOT LIKE '%evalSql%' AS searched_case_fast_path;
 searched_case_fast_path 
-------------------------
 t
(1 row)

CREATE FUNCTION test_case_in_exception_block(a int, b int) RETURNS text AS $$
DECLARE
  label text;
  q int;
BEGIN
  label := CASE WHEN a > 0 THEN 'pos' WHEN a = 0 THEN 'zero' ELSE 'neg' END;
  q := a / b;
  RETURN label || ':' || q;
EXCEPTION
  WHEN division_by_zero THEN
    RETURN label || ':div0';
END;
$$ LANGUAGE plpgsql_v8;
SELECT test_case_in_exception_block(10, 2), test_case_in_exception_block(-3, 0);
 test_case_in_exception_block | test_case_in_exception_block 
------------------------------+------------------------------
 pos:5                        | neg:div0
(1 row)

DROP FUNCTION test_case_in_exception_block(int, int);
-- 10c. EXIT and CONTINUE from inner BEGIN..EXCEPTION..END targeting loop inside outer BEGIN..EXCEPTION..END
CREATE FUNCTION test_nested_subtran_loop_exit() RETURNS text AS $$
DECLARE
  i int := 0;
  acc int := 0;
  after_loop text := 'not_reached';
BEGIN
  LOOP
    i := i + 1;
    BEGIN
      IF i = 2 THEN
        CONTINUE;
      END IF;
      IF i = 4 THEN
        EXIT;
      END IF;
      acc := acc + i * 10;
    EXCEPTION
      WHEN OTHERS THEN
        acc := -999;
    END;
    acc := acc + 1;
  END LOOP;
  after_loop := 'reached:' || acc || ':i=' || i;
  RETURN after_loop;
EXCEPTION
  WHEN OTHERS THEN
    RETURN 'outer_err';
END;
$$ LANGUAGE plpgsql_v8;
SELECT test_nested_subtran_loop_exit();
 test_nested_subtran_loop_exit 
-------------------------------
 reached:42:i=4
(1 row)

DROP FUNCTION test_nested_subtran_loop_exit();
-- 10d. 64-bit bigint comparisons (> INT32_MAX) and exact arithmetic (> 2^53 - 1)
CREATE FUNCTION test_bigint_ops(v bigint) RETURNS jsonb AS $$
DECLARE
  b bigint := 5000000000;
  big1 bigint := 9007199254740993;
  big2 bigint;
  max_b bigint := 9223372036854775806;
  overflow_caught boolean := false;
BEGIN
  big2 := big1 + 1;
  max_b := max_b + 1;
  BEGIN
    max_b := max_b + 1;
  EXCEPTION
    WHEN numeric_value_out_of_range THEN
      overflow_caught := true;
  END;
  RETURN jsonb_build_object(
    'eq_5b', (v = 5000000000),
    'eq_var', (v = b),
    'le_5b', (v <= 5000000000),
    'gt_4b', (v > 4000000000),
    'big2_text', big2::text,
    'max_b_text', max_b::text,
    'overflow_caught', overflow_caught
  );
END;
$$ LANGUAGE plpgsql_v8;
SELECT jsonb_pretty(test_bigint_ops(5000000000));
               jsonb_pretty               
------------------------------------------
 {                                       +
     "eq_5b": true,                      +
     "gt_4b": true,                      +
     "le_5b": true,                      +
     "eq_var": true,                     +
     "big2_text": "9007199254740994",    +
     "max_b_text": "9223372036854775807",+
     "overflow_caught": true             +
 }
(1 row)

DROP FUNCTION test_bigint_ops(bigint);
-- 10e. ON CONFLICT (col), WITH cte (col) AS (...), and UPDATE ... SET (col1, col2) = ...
--      when local PL/pgSQL variables have the same names as table columns
CREATE FUNCTION test_dml_col_shadowing() RETURNS jsonb AS $$
DECLARE
  id int := 10;
  name text := 'shadow_alpha';
  qty int := 99;
  cte_res text;
  final_row plpgsql_v8_items%ROWTYPE;
BEGIN
  INSERT INTO plpgsql_v8_items (id, name, qty)
    VALUES (id, name, qty)
    ON CONFLICT (id) DO UPDATE SET qty = plpgsql_v8_items.qty + EXCLUDED.qty;

  UPDATE plpgsql_v8_items
    SET (name, qty) = (name, qty + 1)
    WHERE plpgsql_v8_items.id = id;

  WITH c (id, name) AS (
    SELECT p.id, p.name FROM plpgsql_v8_items p WHERE p.id = id
  )
  SELECT c.id || ':' || c.name INTO cte_res FROM c;

  SELECT * INTO final_row FROM plpgsql_v8_items p WHERE p.id = id;

  RETURN jsonb_build_object(
    'cte_res', cte_res,
    'final_name', final_row.name,
    'final_qty', final_row.qty
  );
END;
$$ LANGUAGE plpgsql_v8;
SELECT jsonb_pretty(test_dml_col_shadowing());
           jsonb_pretty            
-----------------------------------
 {                                +
     "cte_res": "10:shadow_alpha",+
     "final_qty": 100,            +
     "final_name": "shadow_alpha" +
 }
(1 row)

DROP FUNCTION test_dml_col_shadowing();
-- 10f. plv8.prepare, plan.cursor, and plan.execute error recovery in JS try/catch without relcache leaks
CREATE FUNCTION test_prepare_cursor_error_recovery() RETURNS jsonb AS $$
  var res = {};
  try {
    plv8.prepare('UPDATE plpgsql_v8_items SET non_existent_col = 1');
  } catch (e) {
    res.prep_bad_col = e.sqlerrcode;
  }
  try {
    plv8.prepare('SELECT $1', ['nonexistent_type_xyz']);
  } catch (e) {
    res.prep_bad_type = e.sqlerrcode;
  }
  var p = plv8.prepare('SELECT $1::plpgsql_v8_posint AS x', ['plpgsql_v8_posint']);
  try {
    var c = p.cursor([-5]);
    c.close();
  } catch (e) {
    res.cursor_domain_err = e.sqlerrcode;
  }
  try {
    p.execute([-5]);
  } catch (e) {
    res.exec_domain_err = e.sqlerrcode;
  }
  p.free();
  return res;
$$ LANGUAGE plv8;
SELECT jsonb_pretty(test_prepare_cursor_error_recovery());
           jsonb_pretty           
----------------------------------
 {                               +
     "prep_bad_col": "42703",    +
     "prep_bad_type": "42704",   +
     "exec_domain_err": "23514", +
     "cursor_domain_err": "23514"+
 }
(1 row)

DROP FUNCTION test_prepare_cursor_error_recovery();
-- 10g. FETCH PRIOR / RELATIVE -1, integer FOR loop FOUND, nested EXCEPTION stacked diagnostics, and 0Z002
CREATE FUNCTION test_cursor_prior_and_for_found() RETURNS jsonb AS $$
DECLARE
  cur CURSOR FOR SELECT id, name FROM plpgsql_v8_items WHERE id <= 3 ORDER BY id;
  v_id int;
  v_name text;
  prior_item text;
  rel_neg1_item text;
  found_nonempty boolean;
  found_empty boolean;
  nested_detail text;
  nested_table text;
  nested_constraint text;
  outside_stacked_state text;
  class_cond_state text;
BEGIN
  OPEN cur;
  FETCH NEXT FROM cur INTO v_id, v_name;
  FETCH NEXT FROM cur INTO v_id, v_name;
  FETCH NEXT FROM cur INTO v_id, v_name;
  FETCH PRIOR FROM cur INTO v_id, v_name;
  prior_item := v_id || ':' || v_name;
  FETCH RELATIVE -1 FROM cur INTO v_id, v_name;
  rel_neg1_item := v_id || ':' || v_name;
  CLOSE cur;

  FOR i IN 1 .. 2 LOOP
    PERFORM id FROM plpgsql_v8_items WHERE id = -999;
  END LOOP;
  found_nonempty := FOUND;

  FOR i IN 5 .. 1 LOOP
    NULL;
  END LOOP;
  found_empty := FOUND;

  BEGIN
    RAISE EXCEPTION 'outer boom' USING
      ERRCODE = '23505',
      DETAIL = 'outer detail',
      TABLE = 'outer_tbl',
      CONSTRAINT = 'outer_uk';
  EXCEPTION
    WHEN unique_violation THEN
      BEGIN
        RAISE EXCEPTION 'inner boom' USING
          ERRCODE = '22012',
          DETAIL = 'inner detail',
          TABLE = 'inner_tbl',
          CONSTRAINT = 'inner_ck';
      EXCEPTION
        WHEN division_by_zero THEN
          NULL;
      END;
      GET STACKED DIAGNOSTICS
        nested_detail = PG_EXCEPTION_DETAIL,
        nested_table = TABLE_NAME,
        nested_constraint = CONSTRAINT_NAME;
  END;

  BEGIN
    GET STACKED DIAGNOSTICS outside_stacked_state = RETURNED_SQLSTATE;
  EXCEPTION
    WHEN stacked_diagnostics_accessed_without_active_handler THEN
      outside_stacked_state := SQLSTATE;
  END;

  BEGIN
    RAISE data_exception;
  EXCEPTION
    WHEN data_exception THEN
      class_cond_state := SQLSTATE;
  END;

  RETURN jsonb_build_object(
    'prior_item', prior_item,
    'rel_neg1_item', rel_neg1_item,
    'found_nonempty', found_nonempty,
    'found_empty', found_empty,
    'nested_detail', nested_detail,
    'nested_table', nested_table,
    'nested_constraint', nested_constraint,
    'outside_stacked_state', outside_stacked_state,
    'class_cond_state', class_cond_state
  );
END;
$$ LANGUAGE plpgsql_v8;
SELECT jsonb_pretty(test_cursor_prior_and_for_found());
             jsonb_pretty             
--------------------------------------
 {                                   +
     "prior_item": "2:beta",         +
     "found_empty": false,           +
     "nested_table": "outer_tbl",    +
     "nested_detail": "outer detail",+
     "rel_neg1_item": "1:alpha",     +
     "found_nonempty": true,         +
     "class_cond_state": "22000",    +
     "nested_constraint": "outer_uk",+
     "outside_stacked_state": "0Z002"+
 }
(1 row)

DROP FUNCTION test_cursor_prior_and_for_found();
-- ============================================================================
-- 11. Outer-Plan RETURN QUERY Inlining, Direct SPI-to-Tuplestore Streaming,
--     Statement Plan Caching & Exact NUMERIC Precision
-- ============================================================================
CREATE TABLE rq_orders (
  order_id int PRIMARY KEY,
  customer_id int NOT NULL,
  status text NOT NULL,
  amount numeric(38, 18) NOT NULL
);
INSERT INTO rq_orders VALUES
  (1, 10, 'PAID', 100.123456789012345678),
  (2, 10, 'PENDING', 50.000000000000000001),
  (3, 20, 'PAID', 250.987654321098765432),
  (4, 30, 'CANCELLED', 10.000000000000000000);
-- 11a. Single RETURN QUERY with RETURNS TABLE and named/positional parameters
CREATE FUNCTION rq_orders_by_customer(p_cust int, p_status text)
RETURNS TABLE(order_id int, amount numeric(38, 18)) AS $$
BEGIN
  RETURN QUERY
    SELECT o.order_id, o.amount
    FROM rq_orders o
    WHERE o.customer_id = p_cust AND o.status = $2
    ORDER BY o.order_id;
END;
$$ LANGUAGE plpgsql_v8 STABLE;
-- Verify prosupport was attached automatically at CREATE FUNCTION time
SELECT p.proname, (p.prosupport <> 0) AS has_prosupport
FROM pg_proc p
WHERE p.oid = 'rq_orders_by_customer(int, text)'::regprocedure;
        proname        | has_prosupport 
-----------------------+----------------
 rq_orders_by_customer | t
(1 row)

-- EXPLAIN (COSTS OFF) proves Function Scan is eliminated and replaced by direct table scan
EXPLAIN (COSTS OFF)
SELECT * FROM rq_orders_by_customer(10, 'PAID');
                            QUERY PLAN                            
------------------------------------------------------------------
 Sort
   Sort Key: o.order_id
   ->  Seq Scan on rq_orders o
         Filter: ((customer_id = 10) AND (status = 'PAID'::text))
(4 rows)

SELECT * FROM rq_orders_by_customer(10, 'PAID');
 order_id |         amount         
----------+------------------------
        1 | 100.123456789012345678
(1 row)

-- 11b. LATERAL join with outer Var correlation ($1 correlated from outer query)
EXPLAIN (COSTS OFF)
SELECT c.cid, r.order_id, r.amount
FROM (VALUES (10), (20)) AS c(cid)
CROSS JOIN LATERAL rq_orders_by_customer(c.cid, 'PAID') r
ORDER BY c.cid, r.order_id;
                                          QUERY PLAN                                          
----------------------------------------------------------------------------------------------
 Sort
   Sort Key: "*VALUES*".column1, o.order_id
   ->  Nested Loop
         ->  Values Scan on "*VALUES*"
         ->  Sort
               Sort Key: o.order_id
               ->  Seq Scan on rq_orders o
                     Filter: ((customer_id = "*VALUES*".column1) AND (status = 'PAID'::text))
(8 rows)

SELECT c.cid, r.order_id, r.amount
FROM (VALUES (10), (20)) AS c(cid)
CROSS JOIN LATERAL rq_orders_by_customer(c.cid, 'PAID') r
ORDER BY c.cid, r.order_id;
 cid | order_id |         amount         
-----+----------+------------------------
  10 |        1 | 100.123456789012345678
  20 |        3 | 250.987654321098765432
